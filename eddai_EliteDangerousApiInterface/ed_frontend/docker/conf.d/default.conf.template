upstream django_upstream {
    server ${DJANGO_UPSTREAM_HOST}:${DJANGO_UPSTREAM_PORT};
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    include /etc/nginx/snippets/security-headers.conf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /version.json {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files /version.json =404;
    }

    # Asset Vue con hash nel nome: cache lunga, 404 reale se mancanti (niente fallback SPA).
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Asset Django raccolti (admin, DRF, Swagger, ReDoc) copiati dall'immagine backend in fase di build.
    location /static/ {
        alias /usr/share/nginx/django-static/;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Media persistenti: volume in sola lettura, mai incluso nell'immagine.
    location /media/ {
        alias /usr/share/nginx/media/;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location /api/ {
        proxy_pass http://django_upstream;
        include /etc/nginx/snippets/proxy-common.conf;
    }

    location /admin/ {
        proxy_pass http://django_upstream;
        include /etc/nginx/snippets/proxy-common.conf;
    }

    location /users/ {
        proxy_pass http://django_upstream;
        include /etc/nginx/snippets/proxy-common.conf;
    }

    # Fallback SPA solo per le route applicative Vue.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}

